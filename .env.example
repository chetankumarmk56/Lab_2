# ─── Claude Agent SDK ───────────────────────────────────────────────
# Required to run the lab agents. Get one from https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Model the agents run on. The code default is the cheap claude-haiku-4-5 tier
# (keeps deploys inexpensive). Set claude-opus-4-8 for best quality, or claude-sonnet-5.
CLAUDE_MODEL=claude-opus-4-8

# ─── PostgreSQL (used from Lab 2 onward) ────────────────────────────
# NOTE: host port is 5433, NOT 5432 — your machine already runs a local
# PostgreSQL 18 service on 5432, so the Docker container uses 5433 to
# avoid a conflict. See docker-compose.yml.
DATABASE_URL=postgresql://labs:labs_dev_pw@localhost:5433/agentic_labs

# Read-only role used by the Lab 2 query tool (created by backend/db/seed.py).
READONLY_DATABASE_URL=postgresql://labs_readonly:labs_readonly_pw@localhost:5433/agentic_labs

# ─── Lab 5: On-the-Fly MCP Server Builder ───────────────────────────
# Fernet key for encrypting stored target-DB passwords at rest (REQUIRED for Lab 5).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# ─── Lab 6: Policy Q&A (RAG) — all optional ─────────────────────────
# Without a key, Lab 6 runs a fully local TF-IDF vector space (explainable,
# zero cost). Set a Voyage AI key to switch to semantic embeddings.
VOYAGE_API_KEY=
# LAB6_VOYAGE_MODEL=voyage-3.5-lite
# LAB6_TOP_K=5

# ─── Lab 7: Deep Research (orchestration) — all optional ───────────
# Researchers run on a cheaper tier by default; planner/synthesizer/critic
# use CLAUDE_MODEL. Caps below are the cost/safety rails.
# LAB7_RESEARCHER_MODEL=claude-haiku-4-5
# LAB7_MAX_BREADTH=4
# LAB7_WORKER_CONCURRENCY=3
# LAB7_WORKER_MAX_TURNS=16
# LAB7_WORKER_TIMEOUT_S=180          # wall-clock cap per researcher
# LAB7_DYN_MAX_RESEARCHERS=6         # agent-loop researcher budget ceiling
# LAB7_DYN_MAX_TURNS=24              # agent-loop lead turn cap
# Runs are recorded to backend/data/lab7/runs/*.jsonl for offline replay.
